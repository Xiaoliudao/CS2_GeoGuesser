{
  "name": "cs2-map-guesser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "deploy": "npm run build && wrangler deploy",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest",
    "smoke:e2e": "node scripts/e2e-smoke.mjs",
    "radar:sync": "tsx scripts/content/radar-sync.ts",
    "radar:extract": "tsx scripts/content/radar-extract.ts",
    "question:import": "tsx scripts/content/question-import.ts",
    "questions:import-inbox": "tsx scripts/content/questions-import-inbox.ts",
    "questions:publish-pending": "tsx scripts/content/questions-publish-pending.ts",
    "questions:publish": "tsx scripts/content/questions-publish-pending.ts",
    "questions:migrate-to-d1": "tsx scripts/content/questions-d1-cli.ts migrate",
    "questions:list": "tsx scripts/content/questions-d1-cli.ts list",
    "questions:disable": "tsx scripts/content/questions-d1-cli.ts disable",
    "questions:enable": "tsx scripts/content/questions-d1-cli.ts enable",
    "questions:update-point": "tsx scripts/content/questions-d1-cli.ts update-point",
    "questions:update": "tsx scripts/content/questions-d1-cli.ts update-point",
    "questions:recalculate-coordinates": "tsx scripts/content/questions-recalculate-coordinates.ts",
    "questions:export": "tsx scripts/content/questions-d1-cli.ts export",
    "db:migrate:remote": "wrangler d1 migrations apply cs2-map-guesser-db --remote",
    "assets:upload": "tsx scripts/content/assets-upload.ts"
  },
  "dependencies": {
    "jose": "^6.2.10",
    "react": "latest",
    "react-dom": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "latest",
    "@cloudflare/workers-types": "latest",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "jsdom": "^29.1.1",
    "sharp": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest",
    "wrangler": "latest"
  }
}
